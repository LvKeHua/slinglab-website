{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@stone/exchange/*": ["../packages/exchange/src/*"]
    }
  },
  "include": ["src/**/*.ts", "../packages/exchange/src/**/*.ts"]
}
